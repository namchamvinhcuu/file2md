# Copy thành .env (KHÔNG commit .env thật) — chỉ cần điền key của provider bạn dùng.
# Local dev: main.py tự load .env qua python-dotenv.
# VPS: đặt .env cạnh docker-compose.yml, compose đọc qua env_file.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# Tuỳ chọn — override model mặc định của từng provider
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# OPENAI_MODEL=gpt-4o-mini
# GEMINI_MODEL=gemini-2.5-flash
# DEEPSEEK_MODEL=deepseek-chat

# Đăng nhập — bảo vệ toàn bộ app
# DATABASE_URL: connection string tới PostgreSQL của Nam (postgresql://user:pass@host:5432/dbname)
DATABASE_URL=
# SESSION_SECRET_KEY: chuỗi ngẫu nhiên bất kỳ để ký session cookie, vd: openssl rand -hex 32
SESSION_SECRET_KEY=
# Tuỳ chọn — tắt cookie "secure" khi test local qua http (KHÔNG tắt trên production https)
# COOKIE_SECURE=false

# Relay file tạm public (/api/temp-upload + /dl/) — cho hệ thống ngoài (OpenClaw→WeKnora)
# PUBLIC_BASE_URL: BẮT BUỘC set trên production (đứng sau reverse-proxy như nginx-proxy-manager,
# KHÔNG cùng network loopback với container này) — thiếu sẽ sinh URL http:// sai scheme vì
# uvicorn không trust X-Forwarded-Proto từ proxy chạy container riêng.
PUBLIC_BASE_URL=https://file2md.ntnam.org
# Tuỳ chọn — override default (50MB / 30 phút / /tmp/file2md-relay)
# MAX_RELAY_UPLOAD_BYTES=52428800
# TEMP_UPLOAD_TTL_SECONDS=1800
# TEMP_UPLOAD_DIR=/tmp/file2md-relay
